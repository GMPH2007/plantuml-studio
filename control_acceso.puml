@startuml Control_Acceso_Biometrico
skinparam backgroundColor #FFFFFF
skinparam shadowing true
skinparam roundcorner 12
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam defaultFontSize 14
skinparam titleFontSize 17

skinparam ArrowColor #2563EB
skinparam ArrowThickness 1.5
skinparam ArrowFontSize 13

skinparam ActorBorderColor #2563EB
skinparam ActorBackgroundColor #EFF6FF
skinparam ActorFontColor #1E293B
skinparam ActorFontStyle bold

skinparam ParticipantBorderColor #3B82F6
skinparam ParticipantBackgroundColor #EFF6FF
skinparam ParticipantFontColor #1E293B
skinparam ParticipantFontStyle bold

skinparam DatabaseBorderColor #059669
skinparam DatabaseBackgroundColor #ECFDF5
skinparam DatabaseFontColor #065F46
skinparam DatabaseFontStyle bold

skinparam AltBorderColor #6366F1
skinparam AltBackgroundColor #F8FAFC
skinparam AltHeaderBackgroundColor #EEF2FF
skinparam AltFontColor #312E81

title Control de acceso biométrico

actor "Técnico" as Tecnico
participant "Lector biométrico" as LB
participant "Sistema de acceso" as SA
database "Base de datos" as BD
participant "Puerta de seguridad" as PS

autonumber "<b>[00]</b>"

Tecnico -> LB: Presentar huella dactilar
activate LB
LB -> SA: Enviar datos biométricos
activate SA
SA -> BD: Verificar identidad
activate BD
BD --> SA: Generar resultado de validación
deactivate BD

alt Identidad autorizada
    SA -> PS: Desbloquear Puerta
    activate PS
    PS --> Tecnico: Permitir ingreso
    deactivate PS
    SA -> SA: Registrar acceso
else Identidad no autorizada
    SA -> PS: Mantener puerta bloqueada
    SA --> Tecnico: Acceso denegado
    SA -> SA: Generar alerta
end
deactivate SA
deactivate LB

right footer
Desarrollado por: GMPH2007
Docente: Ing. Javier Eduardo Jaramillo Atoche
GitHub: https://github.com/GMPH2007/plantuml-studio
endfooter

@enduml